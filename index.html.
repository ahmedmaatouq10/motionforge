<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MotionForge AI — Audio-to-Motion Graphics Studio</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0b0d12;
      --panel: #12151d;
      --panel-2: #171b24;
      --border: #262b37;
      --text: #f2f3f7;
      --muted: #9097a6;
      --accent: #b6ff6b;
      --accent-dark: #21321c;
      --purple: #a58aff;
      --danger: #ff7b88;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background:
        radial-gradient(ellipse at 75% -15%, #282044 0, transparent 38%),
        var(--bg);
      color: var(--text);
      font: 14px/1.45 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    button, input, select { font: inherit; }
    button { cursor: pointer; }
    .app { max-width: 1500px; margin: auto; min-height: 100vh; }
    header {
      height: 68px; padding: 0 30px; display: flex; align-items: center;
      justify-content: space-between; border-bottom: 1px solid var(--border);
      background: rgba(11,13,18,.72); position: sticky; top: 0; z-index: 4;
      backdrop-filter: blur(16px);
    }
    .brand { display:flex; align-items:center; gap:11px; font-weight:750; letter-spacing:.02em; }
    .logo {
      width:30px; height:30px; border-radius:9px; color:#10130d; background:var(--accent);
      display:grid; place-items:center; font-weight:900; box-shadow:0 0 26px #b6ff6b33;
    }
    .brand small { color:var(--muted); font-size:11px; font-weight:500; display:block; letter-spacing:.07em; }
    .header-right { display:flex; gap:10px; align-items:center; color:var(--muted); font-size:12px; }
    .status-dot { width:7px; height:7px; background:var(--accent); border-radius:50%; }
    main { padding:30px; }
    .hero { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:24px; gap:20px; }
    .eyebrow { color:var(--accent); font-size:10px; text-transform:uppercase; letter-spacing:.17em; font-weight:750; }
    h1 { margin:7px 0 5px; font-size:clamp(25px,3vw,36px); letter-spacing:-.045em; line-height:1.1; }
    .sub { color:var(--muted); margin:0; }
    .layout { display:grid; grid-template-columns:minmax(0,1fr) 340px; gap:18px; align-items:start; }
    .left, .right { display:grid; gap:16px; min-width:0; }
    .card { background:linear-gradient(145deg,#151922,#11141b); border:1px solid var(--border); border-radius:15px; overflow:hidden; }
    .card-head { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:16px 18px; border-bottom:1px solid var(--border); }
    .card-head h2 { margin:0; font-size:13px; letter-spacing:.01em; }
    .card-body { padding:18px; }
    .muted { color:var(--muted); }
    .tiny { font-size:11px; color:var(--muted); }
    .drop {
      min-height:156px; border:1px dashed #42495b; border-radius:12px; display:grid; place-items:center;
      text-align:center; padding:20px; background:#0e1117; transition:.2s;
    }
    .drop.drag { border-color:var(--accent); background:#b6ff6b0b; }
    .drop-icon { width:37px;height:37px;border-radius:12px;background:#1b222a;color:var(--accent);display:grid;place-items:center;margin:0 auto 10px;font-size:20px; }
    .drop strong { font-size:14px; }
    .drop p { margin:5px 0 12px; color:var(--muted); font-size:12px; }
    .btn {
      border:1px solid var(--border); background:var(--panel-2); color:var(--text); border-radius:9px;
      padding:9px 13px; font-weight:650; transition:.15s;
    }
    .btn:hover { border-color:#50586b; transform:translateY(-1px); }
    .btn.primary { background:var(--accent); color:#11150d; border-color:var(--accent); }
    .btn.primary:hover { background:#c9ff91; }
    .btn:disabled { opacity:.45; cursor:not-allowed; transform:none; }
    .btn.small { padding:7px 10px; font-size:12px; }
    .file-row { display:none; align-items:center; gap:13px; }
    .file-badge { flex:none;width:42px;height:42px;border-radius:11px;background:#222638;color:var(--purple);display:grid;place-items:center;font-size:11px;font-weight:800; }
    .file-info { flex:1; min-width:0; }
    .file-info strong { display:block; overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
    .file-meta { color:var(--muted);font-size:11px;margin-top:3px; }
    .wave-wrap { margin-top:14px; background:#0c0f15; border-radius:9px; padding:5px 8px; }
    #waveform { width:100%; height:62px; display:block; }
    .audio-controls { display:flex; align-items:center; gap:12px; margin-top:9px; }
    .audio-controls input { accent-color:var(--accent); flex:1; min-width:60px; }
    .time { color:var(--muted);font-size:11px;font-variant-numeric:tabular-nums; }
    .analysis-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:9px; }
    .metric { padding:12px; border-radius:10px; background:#0d1016; border:1px solid #202530; min-width:0; }
    .metric span { display:block;color:var(--muted);font-size:10px; }
    .metric strong { display:block;font-size:18px;margin-top:4px;letter-spacing:-.03em; }
    .metric em { font-style:normal;color:var(--muted);font-size:10px;font-weight:500; }
    .bands { display:flex; gap:12px; margin-top:13px; }
    .band { flex:1; min-width:0; }
    .band-top { display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-bottom:5px; }
    .bar { height:5px;background:#282d38;border-radius:5px;overflow:hidden; }
    .bar i { display:block;height:100%;background:linear-gradient(90deg,var(--purple),var(--accent));border-radius:5px; }
    .settings { display:grid; gap:12px; }
    .field label { display:block; color:var(--muted); font-size:11px; margin-bottom:6px; }
    .field input, .field select {
      width:100%; padding:10px 11px; color:var(--text); background:#0d1016;
      border:1px solid var(--border); border-radius:8px; outline:none;
    }
    .field input:focus, .field select:focus { border-color:#737e91; }
    .two { display:grid;grid-template-columns:1fr 1fr;gap:10px; }
    .preview {
      background:#080a0e; position:relative; aspect-ratio:16/9; overflow:hidden;
      display:grid; place-items:center;
    }
    #preview { width:100%;height:100%;display:block; }
    .preview-overlay { position:absolute; left:13px;bottom:12px;pointer-events:none; }
    .pill { border:1px solid #ffffff20;background:#080a0bbf;padding:5px 8px;border-radius:20px;font-size:10px;color:#d7d9df;backdrop-filter:blur(8px); }
    .timeline { padding:14px 18px 17px; }
    .timeline-ruler { display:flex;justify-content:space-between;color:#747b89;font-size:10px;margin-bottom:7px; }
    .scene-track { display:flex;gap:4px;height:42px; }
    .scene-block {
      min-width:0; flex:1; border-radius:6px; border:1px solid #ffffff12;
      background:linear-gradient(135deg,#27213d,#202b29); position:relative; overflow:hidden;
      display:flex;align-items:flex-end;padding:5px 7px;
    }
    .scene-block:nth-child(3n+2) { background:linear-gradient(135deg,#1e3040,#28213c); }
    .scene-block:nth-child(3n) { background:linear-gradient(135deg,#352238,#202b36); }
    .scene-block span { font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#e6e4ec; }
    .story-list { display:grid; gap:8px; }
    .scene-row { display:grid;grid-template-columns:31px minmax(0,1fr) auto;gap:9px;align-items:center;padding:9px;background:#0d1016;border:1px solid #202530;border-radius:9px; }
    .scene-num { width:28px;height:28px;display:grid;place-items:center;border-radius:7px;background:#202331;color:var(--accent);font-size:10px;font-weight:750; }
    .scene-row input { width:100%;min-width:0;padding:7px 8px;border:1px solid #292e3a;background:#12151d;color:var(--text);border-radius:6px;font-size:11px; }
    .scene-time { color:var(--muted);font-size:10px;white-space:nowrap; }
    .story-note { color:var(--muted);font-size:10px;margin-top:10px; }
    .render-box { display:grid;gap:10px; }
    .render-progress { display:none; }
    .progress-head { display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:6px; }
    .progress-track { height:5px;background:#292e38;border-radius:5px;overflow:hidden; }
    .progress-track i { display:block;height:100%;width:0;background:var(--accent);transition:width .15s; }
    .notice { margin-top:15px;padding:10px 11px;border-radius:8px;background:#181b22;color:#9da4b0;font-size:10px;line-height:1.5; }
    .notice b { color:#d6d9e1; }
    .empty-state { color:var(--muted);text-align:center;padding:12px 0;font-size:12px; }
    .toast { position:fixed;right:22px;bottom:22px;background:#252a34;color:white;border:1px solid #42495a;padding:12px 15px;border-radius:10px;z-index:9;display:none;max-width:360px;box-shadow:0 12px 38px #0008; }
    @media(max-width:950px) {
      .layout { grid-template-columns:1fr; }
      .right { grid-template-columns:1fr 1fr; }
      .right .story-card { grid-column:1/-1; }
    }
    @media(max-width:620px) {
      header { padding:0 16px; } main { padding:20px 14px; }
      .hero { align-items:flex-start;flex-direction:column; }
      .right { grid-template-columns:1fr; }
      .right .story-card { grid-column:auto; }
      .analysis-grid { grid-template-columns:repeat(2,1fr); }
      .header-right { display:none; }
    }
  </style>
</head>
<body>
<div class="app">
  <header>
    <div class="brand"><div class="logo">M</div><div>MOTIONFORGE <small>AI · AUDIO-TO-MOTION STUDIO</small></div></div>
    <div class="header-right"><span class="status-dot"></span> Local processing · Your audio stays in this browser</div>
  </header>

  <main>
    <div class="hero">
      <div>
        <div class="eyebrow">Audio → visual film</div>
        <h1>Make your sound move.</h1>
        <p class="sub">Turn an audio track into a timed, art-directed motion graphics film.</p>
      </div>
      <div class="tiny" id="workflowStatus">01 / Import audio</div>
    </div>

    <div class="layout">
      <section class="left">
        <article class="card">
          <div class="card-head"><h2>01 — Import audio</h2><span class="tiny" id="loadStatus">MP3, WAV, AAC, M4A, FLAC, OGG</span></div>
          <div class="card-body">
            <div class="drop" id="dropZone">
              <div>
                <div class="drop-icon">↑</div>
                <strong>Drop your audio here</strong>
                <p>Choose a track to analyze its real rhythm, energy, and frequency profile.</p>
                <button class="btn small" id="chooseBtn">Choose audio</button>
                <input id="fileInput" type="file" accept="audio/*,.mp3,.wav,.aac,.m4a,.flac,.ogg" hidden />
              </div>
            </div>
            <div class="file-row" id="fileRow">
              <div class="file-badge" id="fileType">AUDIO</div>
              <div class="file-info"><strong id="fileName"></strong><div class="file-meta" id="fileMeta"></div></div>
              <button class="btn small" id="replaceBtn">Replace</button>
            </div>
            <div class="wave-wrap" id="waveWrap" hidden>
              <canvas id="waveform"></canvas>
              <div class="audio-controls">
                <button class="btn small" id="playBtn">▶ Play</button>
                <span class="time" id="currentTime">0:00</span>
                <input id="seek" type="range" min="0" max="1000" value="0" />
                <span class="time" id="durationLabel">0:00</span>
              </div>
            </div>
          </div>
        </article>

        <article class="card">
          <div class="card-head">
            <h2>02 — Audio analysis</h2>
            <button class="btn small" id="analyzeBtn" disabled>Analyze audio</button>
          </div>
          <div class="card-body">
            <div id="analysisEmpty" class="empty-state">Import an audio file to see signal-derived insights.</div>
            <div id="analysisResults" hidden>
              <div class="analysis-grid">
                <div class="metric"><span>Duration</span><strong id="mDuration">—</strong></div>
                <div class="metric"><span>Tempo estimate</span><strong id="mTempo">—</strong></div>
                <div class="metric"><span>Detected peaks</span><strong id="mPeaks">—</strong></div>
                <div class="metric"><span>Energy range</span><strong id="mEnergy">—</strong></div>
              </div>
              <div class="bands">
                <div class="band"><div class="band-top"><span>LOW · bass</span><span id="lowVal">—</span></div><div class="bar"><i id="lowBar"></i></div></div>
                <div class="band"><div class="band-top"><span>MID · body</span><span id="midVal">—</span></div><div class="bar"><i id="midBar"></i></div></div>
                <div class="band"><div class="band-top"><span>HIGH · detail</span><span id="highVal">—</span></div><div class="bar"><i id="highBar"></i></div></div>
              </div>
              <p class="tiny" id="analysisNote" style="margin:12px 0 0"></p>
            </div>
          </div>
        </article>

        <article class="card">
          <div class="card-head"><h2>03 — Storyboard & timeline</h2><span class="tiny" id="sceneCount">Awaiting analysis</span></div>
          <div class="timeline" id="timelineArea">
            <div class="empty-state">Analyze audio to create a timed scene structure.</div>
          </div>
        </article>
      </section>

      <aside class="right">
        <article class="card">
          <div class="card-head"><h2>04 — Creative direction</h2><span class="tiny">Editable</span></div>
          <div class="card-body">
            <div class="settings">
              <div class="field">
                <label for="profile">Production profile</label>
                <select id="profile">
                  <option>Music Visual Film</option>
                  <option>Kinetic Typography</option>
                  <option>Podcast Motion Graphics</option>
                  <option>Audio Storytelling</option>
                  <option>Motivational Quote Film</option>
                  <option>Cinematic Sound Design</option>
                  <option>Brand Promo</option>
                  <option>Lyric Video</option>
                  <option>Abstract Motion Film</option>
                  <option>Educational Explainer</option>
                  <option>Scientific Visualization</option>
                  <option>Minimal Editorial Film</option>
                  <option>Experimental Motion Art</option>
                  <option>Social Media Reel</option>
                  <option>Product Advertisement</option>
                  <option>Spiritual and Poetic Visual Film</option>
                </select>
              </div>
              <div class="field"><label for="titleInput">Film title</label><input id="titleInput" maxlength="64" placeholder="e.g. After the Rain" /></div>
              <div class="field"><label for="messageInput">Message or brand text <span class="tiny">(optional)</span></label><input id="messageInput" maxlength="100" placeholder="Add a short line of text" /></div>
              <div class="two">
                <div class="field">
                  <label for="aspect">Aspect ratio</label>
                  <select id="aspect"><option value="landscape">16:9 Landscape</option><option value="square">1:1 Square</option><option value="portrait">9:16 Portrait</option></select>
                </div>
                <div class="field">
                  <label for="palette">Palette</label>
                  <select id="palette"><option value="lime">Electric lime</option><option value="blue">Arctic blue</option><option value="amber">Signal amber</option><option value="rose">Afterglow rose</option></select>
                </div>
              </div>
              <div class="field">
                <label for="motion">Motion intensity</label>
                <select id="motion"><option value="0.7">Subtle</option><option value="1" selected>Balanced</option><option value="1.45">Expressive</option></select>
              </div>
            </div>
            <div class="notice"><b>Analysis note:</b> tempo, energy, frequency bands, and peaks are estimated from the audio signal. Scene labels are creative structure suggestions, not semantic interpretation.</div>
          </div>
        </article>

        <article class="card">
          <div class="card-head"><h2>05 — Motion preview</h2><span class="pill" id="previewTag">LIVE PREVIEW</span></div>
          <div class="preview" id="previewStage">
            <canvas id="preview"></canvas>
            <div class="preview-overlay"><span class="pill" id="previewClock">00:00</span></div>
          </div>
          <div class="card-body render-box">
            <button class="btn primary" id="renderBtn" disabled>Render video · WebM</button>
            <div class="render-progress" id="renderProgress">
              <div class="progress-head"><span id="renderLabel">Rendering video…</span><span id="renderPercent">0%</span></div>
              <div class="progress-track"><i id="renderBar"></i></div>
            </div>
            <div class="tiny">Real-time render · audio included · browser support required</div>
          </div>
        </article>

        <article class="card story-card">
          <div class="card-head"><h2>Scene direction</h2><span class="tiny">Auto-generated</span></div>
          <div class="card-body">
            <div id="storyList" class="story-list"><div class="empty-state">Your scene plan will appear here.</div></div>
            <div class="story-note">Edit scene headlines inline. Changes update the preview and exported film.</div>
          </div>
        </article>
      </aside>
    </div>
  </main>
</div>
<div class="toast" id="toast"></div>

<script>
(() => {
  const $ = id => document.getElementById(id);
  const fileInput = $("fileInput");
  const audio = new Audio();
  audio.preload = "auto";
  audio.crossOrigin = "anonymous";

  let audioContext, mediaSource, recordDestination, decoded = null;
  let objectUrl = null, analysis = null, scenes = [], renderSession = null;
  let playheadRAF = 0, waveformPeaks = [];
  let canvas = $("preview"), ctx = canvas.getContext("2d");
  let previewRAF = 0, lastToast = 0;

  const palettes = {
    lime: { main:"#b6ff6b", secondary:"#a58aff", bg1:"#111b19", bg2:"#17152a" },
    blue: { main:"#74ddff", secondary:"#a58aff", bg1:"#0d1a25", bg2:"#17142a" },
    amber: { main:"#ffc56b", secondary:"#ff7c8d", bg1:"#21180f", bg2:"#211629" },
    rose: { main:"#ff8cba", secondary:"#9d9aff", bg1:"#20121d", bg2:"#17162a" }
  };

  function toast(message) {
    const el = $("toast");
    el.textContent = message;
    el.style.display = "block";
    clearTimeout(lastToast);
    lastToast = setTimeout(() => el.style.display = "none", 4000);
  }
  function fmtTime(s) {
    if (!Number.isFinite(s)) return "0:00";
    const m = Math.floor(s / 60), sec = Math.floor(s % 60);
    return `${m}:${String(sec).padStart(2,"0")}`;
  }
  function setWorkflow(text) { $("workflowStatus").textContent = text; }
  function setAspect() {
    const ratio = $("aspect").value;
    const dims = ratio === "portrait" ? [720,1280] : ratio === "square" ? [900,900] : [1280,720];
    canvas.width = dims[0]; canvas.height = dims[1];
    $("previewStage").style.aspectRatio = `${dims[0]} / ${dims[1]}`;
    drawFrame(audio.currentTime || 0);
  }
  function readMono(buffer) {
    const out = new Float32Array(buffer.length);
    const channels = buffer.numberOfChannels;
    for (let c = 0; c < channels; c++) {
      const data = buffer.getChannelData(c);
      for (let i = 0; i < out.length; i++) out[i] += data[i] / channels;
    }
    return out;
  }

  function drawWaveform(peaks) {
    const el = $("waveform");
    const rect = el.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    el.width = Math.max(1, Math.floor(rect.width * dpr));
    el.height = Math.floor(62 * dpr);
    const c = el.getContext("2d"), w = el.width, h = el.height;
    c.clearRect(0,0,w,h);
    c.fillStyle = "#0c0f15"; c.fillRect(0,0,w,h);
    c.strokeStyle = "#b6ff6b"; c.lineWidth = Math.max(1,dpr);
    const center = h/2, step = w/Math.max(peaks.length,1);
    for (let i=0;i<peaks.length;i++) {
      const amp = Math.max(2*dpr, peaks[i]*center*.88);
      c.beginPath(); c.moveTo(i*step, center-amp); c.lineTo(i*step, center+amp); c.stroke();
    }
    c.strokeStyle = "#ffffff12"; c.beginPath(); c.moveTo(0,center); c.lineTo(w,center); c.stroke();
  }

  async function loadFile(file) {
    if (!file) return;
    if (!file.type.startsWith("audio/") && !/\.(mp3|wav|aac|m4a|flac|ogg)$/i.test(file.name)) {
      toast("This does not appear to be an audio file."); return;
    }
    if (file.size > 200 * 1024 * 1024) {
      toast("Files over 200 MB are not supported by this browser MVP."); return;
    }
    cancelRender();
    $("loadStatus").textContent = "Decoding audio…";
    $("analyzeBtn").disabled = true;
    $("renderBtn").disabled = true;
    try {
      if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
      const copy = await file.arrayBuffer();
      decoded = await audioContext.decodeAudioData(copy.slice(0));
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(file);
      audio.pause();
      audio.src = objectUrl;
      audio.load();

      if (mediaSource) { try { mediaSource.disconnect(); } catch(e) {} }
      mediaSource = audioContext.createMediaElementSource(audio);
      recordDestination = audioContext.createMediaStreamDestination();
      mediaSource.connect(audioContext.destination);
      mediaSource.connect(recordDestination);

      $("dropZone").style.display = "none";
      $("fileRow").style.display = "flex";
      $("waveWrap").hidden = false;
      $("fileName").textContent = file.name;
      $("fileType").textContent = file.name.split(".").pop().slice(0,5).toUpperCase();
      $("fileMeta").textContent = `${fmtTime(decoded.duration)} · ${formatBytes(file.size)} · ${decoded.sampleRate.toLocaleString()} Hz · ${decoded.numberOfChannels} channel${decoded.numberOfChannels === 1 ? "" : "s"}`;
      $("durationLabel").textContent = fmtTime(decoded.duration);
      $("currentTime").textContent = "0:00";
      $("seek").value = 0;
      waveformPeaks = makeWaveform(decoded);
      drawWaveform(waveformPeaks);
      analysis = null; scenes = [];
      $("analysisResults").hidden = true;
      $("analysisEmpty").hidden = false;
      $("analysisEmpty").textContent = "Audio loaded. Analyze the signal to build a storyboard.";
      $("timelineArea").innerHTML = '<div class="empty-state">Analyze audio to create a timed scene structure.</div>';
      $("storyList").innerHTML = '<div class="empty-state">Your scene plan will appear here.</div>';
      $("sceneCount").textContent = "Awaiting analysis";
      $("analyzeBtn").disabled = false;
      $("loadStatus").textContent = "Ready to analyze";
      $("playBtn").textContent = "▶ Play";
      setWorkflow("02 / Analyze audio");
      toast("Audio loaded and decoded in your browser.");
      drawFrame(0);
    } catch (err) {
      console.error(err);
      $("loadStatus").textContent = "Could not decode file";
      toast("Audio decoding failed. Try WAV, MP3, AAC, M4A, FLAC, or OGG supported by your browser.");
    }
  }

  function formatBytes(bytes) {
    if (bytes < 1024*1024) return `${(bytes/1024).toFixed(0)} KB`;
    return `${(bytes/1024/1024).toFixed(1)} MB`;
  }
  function makeWaveform(buffer) {
    const mono = readMono(buffer), count = 1100, size = Math.max(1, Math.floor(mono.length/count));
    const peaks = new Float32Array(count);
    for (let i=0;i<count;i++) {
      let max = 0, start = i*size, end = Math.min(mono.length,start+size);
      for (let j=start;j<end;j++) max = Math.max(max, Math.abs(mono[j]));
      peaks[i] = max;
    }
    return peaks;
  }

  function fft(real, imag) {
    const n = real.length;
    for (let i=1,j=0;i<n;i++) {
      let bit=n>>1;
      for (;j&bit;bit>>=1) j^=bit;
      j^=bit;
      if (i<j) { [real[i],real[j]]=[real[j],real[i]]; [imag[i],imag[j]]=[imag[j],imag[i]]; }
    }
    for (let len=2;len<=n;len<<=1) {
      const angle=-2*Math.PI/len, wr0=Math.cos(angle), wi0=Math.sin(angle);
      for (let i=0;i<n;i+=len) {
        let wr=1,wi=0;
        for (let j=0;j<len/2;j++) {
          const u=i+j,v=i+j+len/2;
          const tr=wr*real[v]-wi*imag[v], ti=wr*imag[v]+wi*real[v];
          real[v]=real[u]-tr; imag[v]=imag[u]-ti;
          real[u]+=tr; imag[u]+=ti;
          const next=wr*wr0-wi*wi0; wi=wr*wi0+wi*wr0; wr=next;
        }
      }
    }
  }

  function analyzeBuffer(buffer) {
    const mono = readMono(buffer), sr = buffer.sampleRate, duration = buffer.duration;
    const windowSize = 1024, hopSeconds = .25, hop = Math.max(1,Math.floor(sr*hopSeconds));
    const frames = [], maxFreq = sr/2;
    for (let start=0;start<mono.length;start+=hop) {
      const real=new Float64Array(windowSize), imag=new Float64Array(windowSize);
      let sum=0, count=0;
      for (let i=0;i<windowSize;i++) {
        const x=mono[start+i] || 0;
        sum += x*x; count++;
        const hann=.5-.5*Math.cos(2*Math.PI*i/(windowSize-1));
        real[i]=x*hann;
      }
      fft(real,imag);
      let low=0,mid=0,high=0,lc=0,mc=0,hc=0;
      for (let k=1;k<windowSize/2;k++) {
        const f=k*sr/windowSize, mag=Math.hypot(real[k],imag[k]);
        if (f>=30 && f<250) {low+=mag;lc++;}
        else if (f>=250 && f<4000) {mid+=mag;mc++;}
        else if (f>=4000 && f<Math.min(12000,maxFreq)) {high+=mag;hc++;}
      }
      frames.push({
        t:start/sr, rms:Math.sqrt(sum/count),
        low:lc?low/lc:0, mid:mc?mid/mc:0, high:hc?high/hc:0
      });
    }
    const rmsMax=Math.max(...frames.map(f=>f.rms),.0001);
    const rmsMin=Math.min(...frames.map(f=>f.rms));
    for (const f of frames) f.energy=f.rms/rmsMax;

    const novelty=frames.map((f,i)=>i?Math.max(0,f.rms-frames[i-1].rms):0);
    const nMax=Math.max(...novelty,.00001);
    const peaks=[];
    for (let i=2;i<novelty.length-2;i++) {
      if (novelty[i] > novelty[i-1] && novelty[i] >= novelty[i+1] && novelty[i] > nMax*.12) peaks.push(i);
    }

    let bpm=0, confidence=0;
    if (novelty.length>24) {
      let best=0,bestLag=0;
      const minLag=Math.max(2,Math.floor(60/180/hopSeconds));
      const maxLag=Math.min(Math.floor(60/60/hopSeconds),Math.floor(novelty.length/2));
      for (let lag=minLag;lag<=maxLag;lag++) {
        let corr=0,den=0;
        for (let i=lag;i<novelty.length;i++) { corr+=novelty[i]*novelty[i-lag]; den+=novelty[i]*novelty[i]; }
        const score=den?corr/den:0;
        if (score>best) {best=score;bestLag=lag;}
      }
      if (bestLag) { bpm=Math.round(60/(bestLag*hopSeconds)); confidence=best; }
    }
    const avgBand=k=>frames.reduce((a,f)=>a+f[k],0)/Math.max(1,frames.length);
    const bands=[avgBand("low"),avgBand("mid"),avgBand("high")], bmax=Math.max(...bands,.00001);
    const loudFrames=frames.filter(f=>f.energy>.65).length;
    return {
      duration, frames, peaks, bpm, confidence, rmsMin, rmsMax,
      energyRange:rmsMax ? 20*Math.log10((rmsMax+1e-6)/(rmsMin+1e-6)) : 0,
      bands:bands.map(x=>x/bmax),
      loudness:loudFrames/Math.max(1,frames.length)
    };
  }

  function buildScenes(data) {
    const count=Math.min(8,Math.max(3,Math.ceil(data.duration/12)));
    const boundaries=[0];
    const step=data.duration/count;
    for (let n=1;n<count;n++) {
      const target=step*n, radius=Math.min(2.5,step*.25);
      let best=target,bestEnergy=Infinity;
      for (const f of data.frames) {
        if (Math.abs(f.t-target)<=radius && f.t>boundaries[boundaries.length-1]+2 && f.t<data.duration-1) {
          if (f.energy<bestEnergy) {bestEnergy=f.energy;best=f.t;}
        }
      }
      boundaries.push(best);
    }
    boundaries.push(data.duration);
    const names=["Opening","Establish","Build","Turn","Peak","Release","Resolve","Outro"];
    return boundaries.slice(0,-1).map((start,i)=>{
      const end=boundaries[i+1];
      const segment=data.frames.filter(f=>f.t>=start&&f.t<end);
      const energy=segment.reduce((a,f)=>a+f.energy,0)/Math.max(1,segment.length);
      const label=energy>.68?"High energy":energy<.2?"Quiet passage":"Developing";
      return {start,end,title:names[i]||`Scene ${i+1}`,energy,label};
    });
  }

  function showAnalysis(data) {
    $("analysisEmpty").hidden=true;
    $("analysisResults").hidden=false;
    $("mDuration").textContent=fmtTime(data.duration);
    $("mTempo").innerHTML=data.bpm ? `${data.bpm}<em> BPM · est.</em>` : `—<em> uncertain</em>`;
    $("mPeaks").textContent=data.peaks.length;
    $("mEnergy").innerHTML=`${Math.max(0,Math.round(data.energyRange))}<em> dB range</em>`;
    ["low","mid","high"].forEach((k,i)=>{
      $(k+"Bar").style.width=`${Math.round(data.bands[i]*100)}%`;
      $(k+"Val").textContent=`${Math.round(data.bands[i]*100)}%`;
    });
    $("analysisNote").textContent=`${data.frames.length} signal windows analyzed · ${data.peaks.length} transient candidates · tempo is an approximate signal estimate, not a guaranteed beat grid.`;
  }

  function renderStoryboard() {
    $("sceneCount").textContent=`${scenes.length} scenes · ${fmtTime(analysis.duration)}`;
    const area=$("timelineArea");
    area.innerHTML="";
    const ruler=document.createElement("div"); ruler.className="timeline-ruler";
    ruler.innerHTML=`<span>00:00</span><span>${fmtTime(analysis.duration/2)}</span><span>${fmtTime(analysis.duration)}</span>`;
    const track=document.createElement("div");track.className="scene-track";
    scenes.forEach((s,i)=>{
      const block=document.createElement("div");block.className="scene-block";
      block.style.flex=`${Math.max(.5,s.end-s.start)} 1 0`;
      const label=document.createElement("span");label.textContent=`${String(i+1).padStart(2,"0")} · ${s.title}`;
      block.appendChild(label);track.appendChild(block);
    });
    area.append(ruler,track);

    const list=$("storyList"); list.innerHTML="";
    scenes.forEach((scene,i)=>{
      const row=document.createElement("div");row.className="scene-row";
      row.innerHTML=`<div class="scene-num">${String(i+1).padStart(2,"0")}</div>
        <input aria-label="Scene ${i+1} headline" value="${escapeHtml(scene.title)}" maxlength="45" />
        <span class="scene-time">${fmtTime(scene.start)}–${fmtTime(scene.end)}</span>`;
      row.querySelector("input").addEventListener("input",e=>{
        scene.title=e.target.value || `Scene ${i+1}`;
        const label=track.children[i]?.querySelector("span");
        if(label) label.textContent=`${String(i+1).padStart(2,"0")} · ${scene.title}`;
      });
      list.appendChild(row);
    });
  }
  function escapeHtml(s) { return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

  function analyze() {
    if (!decoded) return;
    $("analyzeBtn").disabled=true;
    $("analyzeBtn").textContent="Analyzing…";
    $("loadStatus").textContent="Analyzing audio signal…";
    setTimeout(()=>{
      try {
        analysis=analyzeBuffer(decoded);
        scenes=buildScenes(analysis);
        showAnalysis(analysis);
        renderStoryboard();
        $("renderBtn").disabled=false;
        $("analyzeBtn").textContent="Re-analyze";
        $("loadStatus").textContent="Analysis complete";
        setWorkflow("03 / Design your film");
        drawFrame(audio.currentTime||0);
      } catch(err) {
        console.error(err); toast("Audio analysis failed."); $("analyzeBtn").textContent="Analyze audio";
      } finally { $("analyzeBtn").disabled=false; }
    },20);
  }

  function currentFrame(t) {
    if(!analysis || !analysis.frames.length) return {energy:.15,low:.2,mid:.2,high:.2};
    const index=Math.min(analysis.frames.length-1,Math.max(0,Math.floor(t/.25)));
    return analysis.frames[index];
  }
  function activeScene(t) {
    return scenes.find(s=>t>=s.start&&t<s.end) || scenes[scenes.length-1] || {title:"Motion Study",start:0,end:1,label:""};
  }
  function drawFrame(t) {
    if(!ctx || !canvas.width) return;
    const w=canvas.width,h=canvas.height,pal=palettes[$("palette").value]||palettes.lime;
    const frame=currentFrame(t),scene=activeScene(t);
    const intensity=Number($("motion").value)||1;
    const energy=analysis?frame.energy:.12;
    const pulse=(Math.sin(t*2.1)+1)/2;
    const cx=w*.5,cy=h*.5;
    const title=$("titleInput").value.trim() || "Sound in motion";
    const profile=$("profile").value;
    const custom=$("messageInput").value.trim();

    const grad=ctx.createLinearGradient(0,0,w,h);
    grad.addColorStop(0,pal.bg1);grad.addColorStop(1,pal.bg2);
    ctx.fillStyle=grad;ctx.fillRect(0,0,w,h);

    // Editorial grid and a restrained, audio-reactive orbital motif.
    ctx.save();
    ctx.strokeStyle="#ffffff0b";ctx.lineWidth=1;
    const grid=Math.max(38,w/20);
    for(let x=0;x<w;x+=grid){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}
    for(let y=0;y<h;y+=grid){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
    ctx.restore();

    const radius=Math.min(w,h)*(.13 + energy*.075*intensity);
    const rings=3;
    for(let r=0;r<rings;r++){
      ctx.beginPath();
      ctx.arc(cx,cy,radius*(.68+r*.42)+Math.sin(t*1.6+r)*energy*12*intensity,0,Math.PI*2);
      ctx.strokeStyle=r===1?`${pal.main}99`:`${pal.secondary}${r===0?"aa":"55"}`;
      ctx.lineWidth=r===1?2:1;
      ctx.stroke();
    }
    ctx.beginPath();ctx.arc(cx,cy,Math.max(3,radius*.13+energy*10),0,Math.PI*2);
    ctx.fillStyle=pal.main;ctx.fill();

    const bars=76, baseY=h*.77, maxBar=h*.19;
    ctx.save();ctx.lineCap="round";
    for(let i=0;i<bars;i++){
      const x=(i+.5)*w/bars, distance=Math.abs(i-(bars-1)/2)/(bars/2);
      const wave=analysis ? (currentFrame(t + i*.003).energy*.54 + .11) : (.12+.1*pulse);
      const harmonic=.35+.65*Math.abs(Math.sin(i*.42+t*2.2));
      const bh=Math.max(2,Math.min(maxBar,(wave*(1-distance*.55)*harmonic + .035)*maxBar*intensity*2));
      ctx.strokeStyle=i%5===0?pal.secondary:pal.main;
      ctx.globalAlpha=.38 + .6*(1-distance);
      ctx.lineWidth=Math.max(1,w/bars*.38);
      ctx.beginPath();ctx.moveTo(x,baseY-bh);ctx.lineTo(x,baseY+bh*.22);ctx.stroke();
    }
    ctx.restore();

    const pad=w*.075;
    ctx.textAlign="left";ctx.textBaseline="top";
    ctx.fillStyle=pal.main;ctx.font=`700 ${Math.max(11,w*.012)}px system-ui`;
    ctx.fillText(profile.toUpperCase(),pad,h*.08);
    ctx.textAlign="right";ctx.fillStyle="#ffffff99";
    ctx.fillText(scene.label||"AUDIO-RESPONSIVE VISUAL",w-pad,h*.08);

    ctx.textAlign="center";ctx.textBaseline="middle";
    const titleSize=Math.min(w*.075,h*.105);
    ctx.font=`700 ${titleSize}px system-ui, sans-serif`;
    ctx.fillStyle="#f5f3f7";
    fitText(ctx,title,cx,cy+radius*.03,w*.76,titleSize);
    const sub=custom || scene.title;
    ctx.font=`500 ${Math.max(13,w*.019)}px system-ui`;
    ctx.fillStyle="#ffffffb8";
    ctx.fillText(sub,cx,cy+radius+Math.min(h*.095,90));

    ctx.textAlign="left";ctx.textBaseline="bottom";
    ctx.font=`600 ${Math.max(10,w*.012)}px system-ui`;
    ctx.fillStyle="#ffffff91";
    ctx.fillText("MOTIONFORGE  /  "+String(scenes.indexOf(scene)+1).padStart(2,"0"),pad,h*.93);
    ctx.textAlign="right";
    ctx.fillText(fmtTime(t),w-pad,h*.93);
    $("previewClock").textContent=fmtTime(t);
  }
  function fitText(c,text,x,y,maxWidth,size) {
    let shown=text, font=size;
    c.font=`700 ${font}px system-ui, sans-serif`;
    while(c.measureText(shown).width>maxWidth && font>12) {font-=2;c.font=`700 ${font}px system-ui, sans-serif`;}
    c.fillText(shown,x,y);
  }
  function animatePreview() {
    drawFrame(audio.currentTime||0);
    previewRAF=requestAnimationFrame(animatePreview);
  }

  function updateAudioUI() {
    if(!decoded) return;
    const t=audio.currentTime||0,d=decoded.duration||1;
    $("currentTime").textContent=fmtTime(t);
    $("seek").value=Math.round(t/d*1000);
    drawFrame(t);
    if(!audio.paused) playheadRAF=requestAnimationFrame(updateAudioUI);
    else $("playBtn").textContent="▶ Play";
  }

  async function togglePlay() {
    if(!decoded) return;
    try {
      if(!audioContext) audioContext=new (window.AudioContext||window.webkitAudioContext)();
      await audioContext.resume();
      if(audio.paused) { await audio.play(); $("playBtn").textContent="❚❚ Pause"; updateAudioUI(); }
      else { audio.pause(); $("playBtn").textContent="▶ Play"; }
    } catch(e) { toast("Could not play this audio in the browser."); }
  }

  async function startRender() {
    if(!decoded || !analysis) return;
    if(!window.MediaRecorder || !canvas.captureStream) {
      toast("This browser does not support canvas video recording. Try a recent Chrome or Edge."); return;
    }
    const mime=["video/webm;codecs=vp9,opus","video/webm;codecs=vp8,opus","video/webm"]
      .find(type=>MediaRecorder.isTypeSupported(type));
    if(!mime) { toast("No supported WebM recording format was found in this browser."); return; }

    try {
      await audioContext.resume();
      audio.pause();
      audio.currentTime=0;
      drawFrame(0);
      const videoStream=canvas.captureStream(30);
      const tracks=[...videoStream.getVideoTracks(),...recordDestination.stream.getAudioTracks()];
      const stream=new MediaStream(tracks);
      const recorder=new MediaRecorder(stream,{mimeType:mime,videoBitsPerSecond:8_000_000});
      const chunks=[];
      renderSession={recorder,stream,cancelled:false};

      recorder.ondataavailable=e=>{if(e.data && e.data.size) chunks.push(e.data);};
      recorder.onerror=e=>{console.error(e);toast("Video recording failed.");cleanupRender();};
      recorder.onstop=()=>{
        const session=renderSession;
        if(session && !session.cancelled && chunks.length) {
          const blob=new Blob(chunks,{type:mime});
          const url=URL.createObjectURL(blob),a=document.createElement("a");
          a.href=url;a.download=`motionforge-${Date.now()}.webm`;
          document.body.appendChild(a);a.click();a.remove();
          setTimeout(()=>URL.revokeObjectURL(url),60000);
          $("renderLabel").textContent="Render complete · download started";
          $("renderPercent").textContent="100%";$("renderBar").style.width="100%";
          toast("Your WebM video has been rendered and downloaded.");
        }
        cleanupRender();
      };
      $("renderProgress").style.display="block";
      $("renderBtn").textContent="Cancel render";
      $("renderLabel").textContent="Rendering video in real time…";
      $("renderPercent").textContent="0%";$("renderBar").style.width="0%";
      $("previewTag").textContent="RECORDING";
      recorder.start(1000);
      await audio.play();
      const update=()=>{
        if(!renderSession || renderSession.cancelled) return;
        const progress=Math.min(100,(audio.currentTime/decoded.duration)*100);
        $("renderPercent").textContent=`${Math.floor(progress)}%`;
        $("renderBar").style.width=`${progress}%`;
        drawFrame(audio.currentTime);
        if(audio.ended) { if(recorder.state!=="inactive") recorder.stop(); return; }
        renderSession.raf=requestAnimationFrame(update);
      };
      renderSession.raf=requestAnimationFrame(update);
    } catch(err) {
      console.error(err);
      toast("Could not start rendering. Check browser permissions and try again.");
      cancelRender();
    }
  }

  function cleanupRender() {
    if(renderSession?.raf) cancelAnimationFrame(renderSession.raf);
    if(renderSession?.stream) renderSession.stream.getTracks().forEach(t=>t.stop());
    renderSession=null;
    $("renderBtn").textContent="Render video · WebM";
    $("previewTag").textContent="LIVE PREVIEW";
    if(decoded && !audio.paused) audio.pause();
    if(decoded) { $("playBtn").textContent="▶ Play"; }
  }
  function cancelRender() {
    if(!renderSession) return;
    renderSession.cancelled=true;
    if(renderSession.raf) cancelAnimationFrame(renderSession.raf);
    audio.pause();
    if(renderSession.recorder && renderSession.recorder.state!=="inactive") renderSession.recorder.stop();
    else cleanupRender();
    $("renderLabel").textContent="Render cancelled";
  }

  $("chooseBtn").addEventListener("click",()=>fileInput.click());
  $("replaceBtn").addEventListener("click",()=>fileInput.click());
  fileInput.addEventListener("change",e=>loadFile(e.target.files[0]));
  $("analyzeBtn").addEventListener("click",analyze);
  $("playBtn").addEventListener("click",togglePlay);
  $("renderBtn").addEventListener("click",()=>renderSession?cancelRender():startRender());
  $("seek").addEventListener("input",e=>{
    if(decoded){audio.currentTime=(Number(e.target.value)/1000)*decoded.duration;drawFrame(audio.currentTime);}
  });
  audio.addEventListener("ended",()=>{ $("playBtn").textContent="▶ Play"; });
  $("aspect").addEventListener("change",setAspect);
  ["palette","motion","profile","titleInput","messageInput"].forEach(id=>{
    $(id).addEventListener("input",()=>drawFrame(audio.currentTime||0));
    $(id).addEventListener("change",()=>drawFrame(audio.currentTime||0));
  });

  const drop=$("dropZone");
  ["dragenter","dragover"].forEach(type=>drop.addEventListener(type,e=>{e.preventDefault();drop.classList.add("drag");}));
  ["dragleave","drop"].forEach(type=>drop.addEventListener(type,e=>{e.preventDefault();drop.classList.remove("drag");}));
  drop.addEventListener("drop",e=>loadFile(e.dataTransfer.files[0]));
  window.addEventListener("resize",()=>{if(decoded){drawWaveform(waveformPeaks);}});
  setAspect();
  animatePreview();
})();
</script>
